- name: conditions
  hosts: web
  become: yes
  tasks:
  - name: check user exist or not
    ansible.builtin.command: id expense
    ignore_errors: true
    register: USER

  - name: print user info
    ansible.builtin.debug: 
      msg: "User info: {{USER}}"

  - name: create user
    ansible.builtin.command: useradd expense
    when: USER.rc != 0

  - name: say hello
    ansible.builtin.debug:
      msg: "Hello"